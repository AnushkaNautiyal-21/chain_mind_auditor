# Copy this file to .env and fill in your own values.

# Get a free API key from https://www.alchemy.com/ and create a Sepolia app.
# Use the WEBSOCKET url, not the HTTPS one.
ALCHEMY_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Ollama's local API (default is fine if you haven't changed anything)
OLLAMA_URL=http://localhost:11434/api/generate

# Any model you've pulled with `ollama pull <model>`, e.g. phi3, llama3
OLLAMA_MODEL=phi3

# Optional: only watch pending txs sent to this contract address.
# Leave blank/comment out to watch everything (much noisier).
# WATCH_CONTRACT=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984
